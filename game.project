[bootstrap]
main_collection = /example/main.collectionc

[script]
shared_state = 1

[display]
width = 720
height = 1280

[project]
title = LevelPlay
version = 2.0.2
dependencies#0 = https://github.com/andsve/dirtylarry/archive/master.zip
dependencies#1 = https://github.com/defold/extension-automation-bridge/archive/refs/tags/2.0.1.zip

[library]
include_dirs = extension-levelplay
defold_min_version = 1.13.0

[android]
iap_provider = GooglePlay
package = com.defold.levelplay
minimum_sdk_version = 24
target_sdk_version = 36

[levelplay]
unity_ads_android = 1
unity_ads_ios = 1
ios_tracking_usage_description = Your data will be used to provide you a better and personalized ad experience.

[ios]
bundle_identifier = com.defold.levelplay
